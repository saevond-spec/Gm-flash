{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gm-flash",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "BID_LEDGER",
      "database_name": "sprite-bid-ledger",
      "database_id": "7c7ad5f1-0aa5-43f5-ae4f-2bffd9bfe134"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
